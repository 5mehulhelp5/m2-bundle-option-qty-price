{
    "name": "infrangible/m2-bundle-option-qty-price",
    "description": "Multiplies the price of a custom option on a bundle product by the quantity of the item chosen in a linked bundle option, on the product page, in the cart and in the order.",
    "type": "magento2-module",
    "version": "1.5.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Bundle products",
        "Product options",
        "Pricing",
        "custom option price per bundle quantity",
        "bundle option quantity price",
        "option price multiplied by bundle quantity"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-bundle-option-qty-price",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-bundle-option-selection": "~1.2.0",
        "infrangible/m2-catalog-product-option": "~1.3.0",
        "infrangible/m2-catalog-product-option-wrapper": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\BundleOptionQtyPrice\\": "src"
        }
    }
}
